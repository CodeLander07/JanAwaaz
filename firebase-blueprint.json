{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firestore-blueprint.json",
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "Registered government officials and citizens of CivicPulse AI platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["official", "citizen"] },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "officialDetails": { "type": "object" },
        "citizenDetails": { "type": "object" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "citizenClaims": {
      "title": "Citizen Infrastructure Claims",
      "description": "Grassroots infrastructure claims, grievances and priority submissions from citizens",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "createdAt": { "type": "string" },
        "sector": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string" },
        "location": { "type": "object" },
        "urgencyLevel": { "type": "string" },
        "status": { "type": "string" },
        "upvoteCount": { "type": "number" },
        "officialComments": { "type": "array" }
      },
      "required": ["userId", "title", "sector", "status"]
    },
    "hotspotEndorsements": {
      "title": "Hotspot Endorsements",
      "description": "Citizen community endorsements and upvotes for spatial infrastructure demand nodes",
      "type": "object",
      "properties": {
        "hotspotId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" },
        "comment": { "type": "string" }
      },
      "required": ["hotspotId", "userId"]
    },
    "dprAppraisals": {
      "title": "DPR Official Appraisals & Sanctions",
      "description": "Executive approvals, sanctions, and capex budget allocations by verified officials",
      "type": "object",
      "properties": {
        "dprId": { "type": "string" },
        "officialUid": { "type": "string" },
        "officialName": { "type": "string" },
        "designation": { "type": "string" },
        "action": { "type": "string", "enum": ["SANCTIONED", "AMENDED", "REJECTED", "BUDGET_ALLOCATED"] },
        "allocatedAmountCr": { "type": "number" },
        "remarks": { "type": "string" },
        "sanctionTimestamp": { "type": "string" }
      },
      "required": ["dprId", "officialUid", "action"]
    }
  }
}
