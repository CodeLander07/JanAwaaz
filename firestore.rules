rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper to check if user has official role
    function isOfficial() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'official');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isOfficial();
      allow delete: if isOwner(userId);
    }

    // Citizen Infrastructure Claims
    match /citizenClaims/{claimId} {
      allow read: if true; // Public access for open data transparency
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Citizens can upvote, officials can triage/update status
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOfficial());
    }

    // Hotspot Endorsements
    match /hotspotEndorsements/{endorsementId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // DPR Official Appraisals & Sanctions
    match /dprAppraisals/{appraisalId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
